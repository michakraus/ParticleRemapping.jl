# macOS file system data
.DS_Store

# Files generated by invoking Julia with --code-coverage or --track-allocation
*.jl.cov
*.jl.*.cov
*.jl.mem
*.jl.*.mem

# The documentation build
docs/build/
docs/site/

# The output directories of scripts/, root-anchored: `runs/` holds the data a run produced,
# `results/` the figures, animations and reports. Both are regenerable from scripts/.
/runs
/results

# Resolved per machine and per Julia version; Project.toml is the record.
Manifest.toml
